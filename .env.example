# Copy this file to .env (and load it, e.g. with `python-dotenv` or your host's
# environment variable settings) before deploying to production.

# A long, random string used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Port the app listens on (most hosts set this for you automatically)
PORT=5000

# Set to 0 in production
DEBUG=0
